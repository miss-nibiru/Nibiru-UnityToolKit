--- !u!114 &-8382204807930457379
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Strawberry_Press3
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: strawberry_press3_line
  editorPosition: {x: 965, y: 1995}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You gesture toward Blueberry. \u201CI want to know what you did. What you
    used to make that awful creature answer to you!\u201D\n\nWhy is she not understanding
    what she's being asked? Strawberry just shakes her head slowly. <color=#5E9FBC>\u201CI
    didn't make her... we have been friends for a long time...\u201D</color>\n\nBlueberry
    neighs with discomfort, and Strawberry instantly starts petting her again. <color=#5E9FBC>\u201CShe
    really loves pets and attention. Such a silly girl.\u201D</color>\n\n\u201CShe
    just answered to you,\u201D you say. \u201CEverything reacts to something. Did
    you train it? Starve it? Hit it into compliance? What. Was. IT?\u201D\n\n<color=#5E9FBC>\u201CMaybe
    that is why so many things around you are always in pain,\u201D</color> Strawberry
    replies quietly.\n\nYour shoulders go rigid, your jaw tightens, and you hold
    your breath for a second. Blueberry\u2019s eyes stay fixed on you, but it does
    not move."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: strawberry_press3_choices_1
