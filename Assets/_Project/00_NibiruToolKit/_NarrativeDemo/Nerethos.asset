  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: serena_entry_line
  editorPosition: {x: 2615, y: 6670}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "\u201CShut the \u0129\u012A\u012B\u0136\u0138oor. ...meant to \u0102\u0103\u0104\u0105\u0106\u0107\u0108\u0109\u010A.\u201D\n\nYou
    look at Serena... you think. You stumble as you close the door behind you. <i>Dizzy...</i>\n\nYou
    hear Serena\u2019s voice again. <color=#FF675E>\u201CThe halls of this pa\u0160\u0161\u0162\u0163\u0164\u0165\u0166\u0167\u0168
    \u0139\u013A\u013B\u013C\u013D\u013E\u013F\u0140\u0141\u0142\u0143 strays,\u201D</color>
    she continues, <color=#FF675E>\u201CAnd yet \u0112\u0113\u0114\u0115\u0116\u0117\u0118\u0119\u011A\u011B\u011C\u011D\u011E\u011F\u0120\u0121.
    Why \u0112\u0113\u0114\u0115\u0116\u0117\u0118\u0119\u011A\u011B\u011C\u011D\u011E\u011F\u0120\u0121
    you so?\u201D</color>\u201CShut the door. You are not meant to be here.\u201D\n\nYou
    look at Serena as you close the door behind you. Serena stands near the centre
    of the room, posture straight, chin lifted. She is just standing there, waiting
    for your answer. It doesn\u2019t seem she would call the guards. She does not
    reach for a weapon.\n\nShe studies you. <color=#FF675E>\u201CThe halls of this
    palace do not welcome <i>strays</i>,\u201D</color> she continues, <color=#FF675E>\u201CAnd
    yet you walk among them. Why would they welcome you so?\u201D</color>"
