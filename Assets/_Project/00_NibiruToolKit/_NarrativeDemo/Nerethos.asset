  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: WarRoomA_Sleep
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: warrooma_sleep_line
  editorPosition: {x: 910, y: 4305}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You move as they shift to turn, closing the distance instantly. Your arm
    extends towards the closest one, grabbing and pulling him down before he can
    even react.\n\nThe second guard begins to turn, but you don\u2019t give him the
    time. You\u2019re already behind him. A sharp strike to the neck and he drops.
    The first one struggles for a second before you grab their head and bang it against
    the marble floor.\n\nSilence.\n\nYou drag both bodies quickly, back into the
    room you just left. You close the door behind you silently and look around. No
    witnesses. Let's press on.<color=#a674e8>\"Clean.\"</color>"
  importedSegments:
  - text: "You move as they shift to turn, closing the distance instantly. Your arm
      extends towards the closest one, grabbing and pulling him down before he can
      even react.\n\nThe second guard begins to turn, but you don\u2019t give him
      the time. You\u2019re already behind him. A sharp strike to the neck and he
      drops. The first one struggles for a second before you grab their head and
