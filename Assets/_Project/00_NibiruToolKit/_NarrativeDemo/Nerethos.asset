--- !u!114 &4438783371444353466
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Damon_Entry
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: damon_entry_line
  editorPosition: {x: 2615, y: 8595}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Serena doesn't move a muscle. You react quicker than she does, your body
    shifting back, pressing flat against the wall behind the door just as it begins
    to open.\n\nFrom where you stand, you scan the room again. To your left, a tall
    window stands slightly open, thin curtains dancing with the night air. Yes, an
    exit.\n\nSerena exhales softly, coming back to her senses and walking forward
    towards the door that opens now fully.\n\n<color=#E5200F>\u201CMy Queen,\u201D</color>
    a calm voice says. Familiar, almost...\n\n<color=#E5200F>\u201CI was not expecting
    a visit this evening, my Lord,\u201D</color> she replies. Her voice falters,
    if only for a moment, before she steadies it again. <color=#f4a6b8>\u201CI trust
    there is a reason.\u201D</color>\n\n<color=#E5200F>\u201CCertainly,\u201D</color>
    he says. <color=#E5200F>\u201CThere have been reports of unaccounted movement
    in the castle.\u201D</color>\n\nYou get tense, pressing yourself harder against
    the wall. Serena shifts her gaze towards you for a second and then back at the
    voice. <color=#f4a6b8>\u201CI have seen nothing of concern,\u201D</color> she
    answers quickly.\n\n... but the voice doesn't respond."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: damon_entry_choices_1
