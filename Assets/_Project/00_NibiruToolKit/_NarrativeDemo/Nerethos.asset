--- !u!114 &-96879965453413790
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Lektryon_Alchemy_Strike
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: lektryon_alchemy_strike_line
  editorPosition: {x: 2010, y: 3150}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "He tries to stand up immediately, but he's too slow. You\u2019re already
    on him.\n\nYour blade comes down, forcing him to raise his sword to defend. The
    impact lands heavy.\n\nYou attack again and again, each strike coming faster,
    not giving him time to reset and stand up. He really is trying to keep up.\n\nYou
    can hear his breathing\u2014heavy and uneven. But you still don't stop. You can't.
    You hear her again. Her damned cackling laughter drilling into your skull.\n<color=#a674e8>\u201CDoesn't
    this feel good?\u201D</color> You smile under your mask and keep going. Your
    blades keep coming down on him. As he tries to block again, you break through
    it. An opening. Your second blade follows toward the target, and this time, it
    hits.\n\nHe hisses and groans through his teeth. You keep your blade buried deep
    into his shoulder as you lean forward so only he can hear you."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: lektryon_alchemy_strike_choices_1
