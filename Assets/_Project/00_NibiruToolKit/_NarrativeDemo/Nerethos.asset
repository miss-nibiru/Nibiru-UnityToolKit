  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: TownDream
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: towndream_line
  editorPosition: {x: 2615, y: 565}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: 'You walk down to the docks of the town. You know this place too well. Shipments
    of alchemy come to this port very often, and it''s on you for them to go smoothly.


    "<i>Alchemy</i>A
    substance central to daily life in Nerethos. Used to recover, endure, and survive.
    With the ruling family focused on power, the Emerald Order has become its primary
    distributor, through their black market ring.

    , huh?" you think as you take
    a vial out of your coat pocket.


    The purple liquid inside shifts as you
    turn it in your hand, almost alive.


    You watch it for a moment.'
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
