  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: TownDream2
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: towndream2_line
  editorPosition: {x: 2615, y: 840}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You bring the vial to your lips and drink. The taste is disgusting, metallic,
    and it burns all the way down. It doesn't matter.\n\nYou feel it immediately.
    Your body feels lighter. You open your eyes, and the world appears more detailed
    and vibrant; the sounds are clearer, and the edges are sharper.\n\nThe steam,
    the valves, the creak of metal, the cracks in the walls. You <i>feel</i> it all.\n<color=#a674e8>\u201CYou
    are ready.\u201D</color> A whisper.You close your hand around the vial and put
    it back in your coat.\n\n\u201CNot now.\u201D\n\nYou know what it does to you.
    Heightened senses and dexterity. You are the Emerald Order's most complete weapon
    with it... but there's no need for that right now.You keep moving."
  importedSegments:
