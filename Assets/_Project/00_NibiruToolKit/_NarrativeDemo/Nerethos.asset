  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Lektryon_Alchemy_PreStrike
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: lektryon_alchemy_prestrike_line
  editorPosition: {x: 1790, y: 2820}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You move quickly before he can recover. You turn around him, your second
    blade already coming down as you circle to his back. It's over.\n\nYou smile
    and turn back to him, blades coming down hard. Lektryon barely has a chance to
    react, but you still don't give him space. Another strike, then another. He\u2019s
    not keeping up.\n\nYou can feel it now. The speed. The strength. Your next blade
    hits harder, making him lose balance and stumble back.\n\n<color=#a674e8>\u201CFinish
    him. Don't stop.\u201D</color> You hear it again."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: lektryon_alchemy_prestrike_choices_1
