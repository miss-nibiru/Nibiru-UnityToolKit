  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Shrine
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: shrine_line
  editorPosition: {x: 3715, y: 4580}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You take the right corridor and end up by a door that looks older than the
    rest along your path. You push it slightly. It opens with a creak, and you slip
    inside. The overwhelming smell of sage and moonflowers reaches you.\n\nThe space
    opens into a circular chamber, pillars framing the center of the room. Statues
    rise along the pillars, carved in stone. The same woman\u2019s figure repeats
    throughout the room, over and over again. Always draped in flowing dark fabric,
    stars stitched into it. All eyes fixed on you.\n\nThe Goddess NyxThe goddess
    of night, whose name is spoken with reverence among the aristocracy.\n. Your
    jaw tightens<color=#a674e8>\u201COh!! There she is!\u201D</color> You hear it
    at the back of your head, accompanied by a laugh.At the center of the room lies
    a concave stone, carved inward, decorated all around with black candles. You
    step closer, and you see a thick, dark liquid in it. Blood? It seems to have
    been here for a while now.\n\nYou stand in the center of the room, and your eyes
    move around it again.\n\n<i>\u201CSo they praise Nyx, huh?\u201D</i>\n\nYou've
    seen enough. You turn around, and as you place your hand on the knob, you hear
    something... Footsteps?"
  importedSegments:
  - text: "You take the right corridor and end up by a door that looks older than
      the rest along your path. You push it slightly. It opens with a creak, and
      you slip inside. The overwhelming smell of sage and moonflowers reaches you.\n\nThe
      space opens into a circular chamber, pillars framing the center of the room.
      Statues rise along the pillars, carved in stone. The same woman\u2019s figure
      repeats throughout the room, over and over again. Always draped in flowing
      dark fabric, stars stitched into it. All eyes fixed on you.\n\nThe Goddess
      NyxThe goddess of night, whose name is spoken with reverence among the aristocracy.\n.
      Your jaw tightens"
    condition:
      tokens: []
  - text: "<color=#a674e8>\u201COh!! There she is!\u201D</color> You hear it at the
      back of your head, accompanied by a laugh."
