  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: WakeUp2
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: wakeup2_line
  editorPosition: {x: 2835, y: 1445}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: 'You stand still and look down at your hands. This was coming; you always
    knew.


    You take your mask off and smirk, raising your arms over your head,
    ready for it.


    <i>"Facey, move away!"</i>, you hear, but it''s distant.
    It doesn''t matter.


    In a quick second, the darkness reaches you. It snakes
    upwards your legs, pulling you down to the ground immediately.


    You feel
    our body getting bigger, stronger. You feel powerful.'
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: wakeup2_choices_1
