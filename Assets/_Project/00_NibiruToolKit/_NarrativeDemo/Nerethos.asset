  id: strawberry_watch_line
  editorPosition: {x: 1680, y: 1005}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "The answer is not good enough, but you don't press harder. You cross your
    arms and lean your back against the wall behind you, still observing them.\n\nStrawberry
    starts humming a song Blueberry seems to enjoy. She lowers her head slightly,
    pressing into Strawberry's petting. She just looks so comfortable.\n\nYou sigh
    and see Blueberry\u2019s eyes flick toward you for a second\u2026 then back to
    her."
  importedSegments: []
  useImportedSegments: 0
