--- !u!114 &8388836602757929244
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Strawberry_Talk3
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: strawberry_talk3_line
  editorPosition: {x: 360, y: 2270}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Strawberry places her hands on Blueberry's neck and side and starts caressing
    her, calming her down. The creature neighs softly and lays her head down. \u201CIt's
    okay girl, it's all good,\" she says. \"She doesn\u2019t like loud noises or
    things moving fast. It scares her.\u201D\n\nYou look at the creature again, still
    ready to defend. There is no more tension or stance... just calm.<color=#a674e8>\u201CShe\u2019s
    playing you,\u201D</color>You hear soflty in the back of your head.<color=#a674e8>\u201CAnd
    just stand there like a dumbass watching! What a move!\u201D</color> Your jaw
    tightens. <i>She is playing me.</i> That would make more sense.You feel your
    jaw tighten a little. The creatures you've seen and capture were erratic, capable
    of tearing trained men in half in a hearbeat.\u201C\u2026What did you do?\u201D
    you ask. \u201CTo make it listen to you like that.\u201D\n\nStrawberry frowns
    and looks at you again. \u201CI told you! She wants to be with me. And I want
    to be with her. I didn\u2019t make her do anything. We are just... together\u201D"
  importedSegments:
  - text: "Strawberry places her hands on Blueberry's neck and side and starts caressing
      her, calming her down. The creature neighs softly and lays her head down. \u201CIt's
      okay girl, it's all good,\" she says. \"She doesn\u2019t like loud noises or
      things moving fast. It scares her.\u201D\n\nYou look at the creature again,
      still ready to defend. There is no more tension or stance... just calm."
    condition:
      tokens: []
  - text: "<color=#a674e8>\u201CShe\u2019s playing you,\u201D</color>You hear soflty
      in the back of your head.<color=#a674e8>\u201CAnd just stand there like a dumbass
      watching! What a move!\u201D</color> Your jaw tightens. <i>She is playing me.</i>
      That would make more sense."
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
