--- !u!114 &2918552110203333802
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Valerian_Cont
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: valerian_cont_line
  editorPosition: {x: 2615, y: 3370}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "He continues.\n\n<color=#199D7C>\"The Erythros family has been destroying
    our island and our people for far too long... always hidden in that castle; always
    within the shadows.\"</color>\n\nHe turns from you and moves toward the window.
    His silhouette sharply cuts the faint light spilling in, his cloak falling straight
    down his back. Valerian stands with his hands resting behind his back, settling
    his sight on the distant castle.\n\n<color=#199D7C>\u201CTonight, you step into
    their domain\u2026\u201D</color> he says firmly, <color=#199D7C>\u201Cand you
    bring me a way to destroy them.\u201D</color>\n\nHe looks back at you with a
    stern expression. With expectation.\n\n<color=#199D7C>\u201CCome back with answers,
    Facey. We need them.\u201D</color>"
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: valerian_cont_choices_1
--- !u!114 &2936061370825359763
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Go
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: go_line
  editorPosition: {x: 2615, y: 3645}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Valerian leaves, closing the door behind him. No additional command, just
    the certainty you\u2019ll do it to perfection. The mission is clear: Enter, observe,
    return. Nothing more.\n\nJust before heading out, you stop and take a new vial
    from your pouch. You know it would sharpen your senses and make this faster and
    easier.\n\nBut this is not a fight. This is just recon and you must be precise,
    controlled and clean. You take a slow breath.\n\nThe choice is yours\u2026"
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: go_choices_1
