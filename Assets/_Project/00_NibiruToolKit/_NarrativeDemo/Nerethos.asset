  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Catacombs_A2
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: catacombs_a2_line
  editorPosition: {x: 1955, y: 5295}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: 'You can''t move closer, but your eyes move past them instead, trying to
    make sense of why they would be guarding this area so closely.


    The doors
    are thick and reinforced, as if to keep something big and destructive inside,
    but there''s no sight of anything that could confirm it.


    You close your
    eyes, hoping to hear anything. You hold still. At first, nothing, but then you
    hear soft crying. Multiple? You shift slightly, adjusting your angle, paying
    closer attention. Is it coming from the basement?


    <i>"I can''t move closer,
    dammit..."</i>'
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
