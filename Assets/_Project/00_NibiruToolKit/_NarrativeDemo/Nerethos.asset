  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Lektryon_Alchemy
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: lektryon_alchemy_line
  editorPosition: {x: 1405, y: 2875}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You grab the vial quickly from his hand and drink it. The taste is sharp,
    metallic.\n\n<i>\u201CThe Order approves.\u201D</i> This thought is always there,
    looming. You'll do whatever Valerian needs his weapon to be.\n\nLektryon is already
    moving. No time to get pulled into your thoughts now.\n\nYou kick the training
    weapon aside and unsheathe your parazonium A short, carbon steel blade meant
    for close combat, worn at the hip. Designed for a more precise and controlled
    combat style. Facey carries a pair.\n, and with a quick move, you meet his sword,
    locking it in place. The impact is strong, but you hold your footing and step
    in, unbalancing his stance."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
