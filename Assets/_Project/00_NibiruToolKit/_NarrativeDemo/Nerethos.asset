  m_Name: PrisonSeparated_GrabThreat
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: prisonseparated_grabthreat_line
  editorPosition: {x: 1405, y: 1885}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You reach into the cell, pulling Strawberry toward you.\n\n\u201CAnswer
    me, now!\u201D\n\nHer eyes keep looking past you. Still nothing.\n\nAfter a minute,
    you let her go, step away, and turn your back. You hear the faint scrape of Strawberry
    standing up. What is she waiting for? Something, anything..."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: prisonseparated_grabthreat_choices_1
--- !u!114 &1396570017305724520
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Lektryon_NoAlchemy
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: lektryon_noalchemy_line
  editorPosition: {x: 1130, y: 2985}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You kick the sword he tossed at you away.\n\nHis face tightens as he looks
    at you. You pushed his buttons again, so much so that he doesn't even wait for
    you to be ready to close the distance first, swinging at you with a committed
    strike.\n\nYour parazoniums A short, carbon steel blade meant for close combat,
    worn at the hip. Designed for a more precise and controlled combat style. Facey
    carries a pair.\nare already in your hands before his strike reaches you. You
    meet his steel at the right angle, redirecting his strike and making it miss
    you entirely.\n\nYou shift your footing, circling around him, eyes locked on
    his next movement.\n\nIn a beat, he turns back at you, with more weight behind
    his attacks now. <i>\u201CHe's being brash and sloppy.\u201D</i> You step around
    another swing, then another, avoiding each of them."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: lektryon_noalchemy_choices_1
