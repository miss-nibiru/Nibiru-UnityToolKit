--- !u!114 &-2731238002788939250
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: WarRoomA_Kill
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: warrooma_kill_line
  editorPosition: {x: 910, y: 4580}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You move as they shift to turn, closing the distance instantly. Your arm
    extends toward the closest one, grabbing him by the collar and yanking him down
    with force, his body hitting the marble, hard. He gasps, looking for air, before
    your boot lands on his neck, crushing it.\n\nThe second guard begins to turn,
    but you don\u2019t give him the time. You\u2019re already behind him. Both your
    hands grab his head and twist it violently, accompanied by a loud snap. He drops.\n\nSilence.<color=#a674e8>\"Oh,
    look at you.\"</color> You feel the air shifting, turning cold. You can hear
    it closer now. <i>\"What...?\"</i> She\u2019s not behind you anymore. She\u2019s
    right there, beside the bodies you just took care of. <color=#a674e8>\"Now we
    are talking.\"</color> She says as she pushes the head of one of the guards with
    her foot, cackling loudly.You shake your head. Keep. On. Moving. Now."
  importedSegments:
  - text: "You move as they shift to turn, closing the distance instantly. Your arm
      extends toward the closest one, grabbing him by the collar and yanking him
      down with force, his body hitting the marble, hard. He gasps, looking for air,
      before your boot lands on his neck, crushing it.\n\nThe second guard begins
      to turn, but you don\u2019t give him the time. You\u2019re already behind him.
      Both your hands grab his head and twist it violently, accompanied by a loud
      snap. He drops.\n\nSilence."
    condition:
      tokens: []
  - text: "<color=#a674e8>\"Oh, look at you.\"</color> You feel the air shifting,
      turning cold. You can hear it closer now. <i>\"What...?\"</i> She\u2019s not
      behind you anymore. She\u2019s right there, beside the bodies you just took
      care of. <color=#a674e8>\"Now we are talking.\"</color> She says as she pushes
      the head of one of the guards with her foot, cackling loudly."
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
          variable: {fileID: 11400000, guid: e2b5c5b2a4f8c4d219da0eec43e8017c, type: 2}
          comparison: 3
          booleanValue: 0
          integerValue: 3
          floatValue: 3
          stringValue: 3
          invert: 0
  - text: You shake your head. Keep. On. Moving. Now.
    condition:
      tokens: []
