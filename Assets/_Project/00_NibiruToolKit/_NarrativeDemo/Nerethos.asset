--- !u!114 &-2416338535424649164
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Serena_Break
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: serena_break_line
  editorPosition: {x: 2615, y: 7715}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You continue to hold her wrist and don\u2019t step back. Serena watches
    you for a moment longer. There\u2019s something in her expression that wasn\u2019t
    there before. Defeated, maybe?\n\n<color=#FF675E>\u201CThis was never meant to
    be... fair either way.\u201D</color> Her gaze drifts just slightly, then returns
    to where your eyes should be through the mask. <color=#FF675E>\u201CThe Gods
    set things in motion long before either of us had the chance to choose.\u201D</color><color=#a674e8><i>Greater
    than themselves?</i></color> Eris cackles.<color=#a674e8><i>\u201CListen to her.
    Trying to pass fear as faith again... They always do!\u201D</i></color>Eris shifts
    her weight against the wall, watching Serena more closely now, her smile widening.
    <color=#a674e8>\u201CShe\u2019s getting closer, kitten\u2026 do ya like that?\u201D</color>Serena
    exhales again. Slower and quieter. <color=#FF675E>\u201CI am doing what I can,\u201D</color>
    she whispers, <color=#FF675E>\u201Cto make sure he doesn't make them suffer more
    than they already must.\u201D</color>\n\nA pause. She doesn't look away."
  importedSegments:
  - text: "You continue to hold her wrist and don\u2019t step back. Serena watches
      you for a moment longer. There\u2019s something in her expression that wasn\u2019t
