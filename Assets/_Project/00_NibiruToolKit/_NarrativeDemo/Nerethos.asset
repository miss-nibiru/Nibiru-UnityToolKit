      tokens: []
  - text: "<color=#a674e8>\u201CWhat are you doing here, little rat,\u201D</color>
      she cackles. <color=#a674e8>\u201C\u2026or maybe you should be here?\u201D</color>"
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
