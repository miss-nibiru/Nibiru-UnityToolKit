--- !u!114 &2729848111584449431
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: TownDream3
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: towndream3_line
  editorPosition: {x: 2615, y: 1115}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You finally arrive at the docks and lift your head. Amongst the fog, you
    see a figure on her knees you recognize immediately. Her long white hair, usually
    so carefully kept, hangs tangled. Her dress, always immaculate, is torn, stained.\n\n<i>\u201CQueen
    Serena...\u201D</i> She doesn\u2019t look up.\n\nBehind her, a dark veil stretches
    upwards, almost swallowing her whole, extending inward. You take a step towards
    her when you hear a sound behind you.\n\nYou turn and you see Strawberry and
    Blueberry Blueberry is a rare part rooster, part horse creature with the ability
    to fly and incredible strength. She can shape light and generate intense heat
    bursts, growing stronger under direct sunlight and emitting a faint glow when
    fully energized. She is currently held captive by the Emerald Order. Strawberry
    is a human closely attuned to her, kept nearby to keep the creature calm.\nstanding
    on the other side. Light faintly glows around them, slowly pushing forward.\n\nYou
    stand between them.<color=#a674e8>\u201CWho cares about them! What's in it for
    you?\u201D</color> There she is again."
  importedSegments:
  - text: "You finally arrive at the docks and lift your head. Amongst the fog, you
      see a figure on her knees you recognize immediately. Her long white hair, usually
      so carefully kept, hangs tangled. Her dress, always immaculate, is torn, stained.\n\n<i>\u201CQueen
      Serena...\u201D</i> She doesn\u2019t look up.\n\nBehind her, a dark veil stretches
      upwards, almost swallowing her whole, extending inward. You take a step towards
      her when you hear a sound behind you.\n\nYou turn and you see Strawberry and
      Blueberry Blueberry is a rare part rooster, part horse creature with the ability
      to fly and incredible strength. She can shape light and generate intense heat
      bursts, growing stronger under direct sunlight and emitting a faint glow when
      fully energized. She is currently held captive by the Emerald Order. Strawberry
      is a human closely attuned to her, kept nearby to keep the creature calm.\nstanding
      on the other side. Light faintly glows around them, slowly pushing forward.\n\nYou
      stand between them."
    condition:
      tokens: []
  - text: "<color=#a674e8>\u201CWho cares about them! What's in it for you?\u201D</color>
      There she is again."
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
          variable: {fileID: 11400000, guid: e2b5c5b2a4f8c4d219da0eec43e8017c, type: 2}
          comparison: 3
          booleanValue: 0
          integerValue: 1
          floatValue: 1
          stringValue: 1
          invert: 0
  useImportedSegments: 1
