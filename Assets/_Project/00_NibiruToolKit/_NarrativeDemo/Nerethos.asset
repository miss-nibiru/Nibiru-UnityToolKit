--- !u!114 &5285269966649844158
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: WarRoomA
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: warrooma_line
  editorPosition: {x: 1845, y: 4195}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You move through the adjacent corridor until you reach a larger set of doors.
    You quickly move inside and close them behind you.\n\nThe room is wide. It has
    a long table at its center, surrounded by high chairs. Multiple maps cover the
    walls, marked with ink and charcoal. This looks like a room where political decisions
    are made.\n\nYou step further in, your eyes moving quickly from wall to wall,
    from papers to books to markings, to scrolls. Too much.\n\nYou hear voices outside
    the room, patrolling around. Shit, there's no time and there are too many details.<color=#a674e8>\u201CPick
    something useful.\u201D</color> The voice slips in, pleased. <color=#a674e8>\u201COr
    don't. Keep wasting time.\u201D</color>"
  importedSegments:
  - text: 'You move through the adjacent corridor until you reach a larger set of
      doors. You quickly move inside and close them behind you.


      The room
      is wide. It has a long table at its center, surrounded by high chairs. Multiple
      maps cover the walls, marked with ink and charcoal. This looks like a room
      where political decisions are made.


