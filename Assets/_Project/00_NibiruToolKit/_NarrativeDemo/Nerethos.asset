--- !u!114 &-8708192823756079317
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Catacombs_Ichor2
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: catacombs_ichor2_line
  editorPosition: {x: 3275, y: 5735}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You had not realized that you had leaned forward to see better until you
    stopped yourself from moving further into the candlelight.\n\n<i>\u201CShit...\u201D</i>
    You pull yourself back just a bit, hiding behind the wall again. You take a small
    breath to steady yourself and push your view out again, just a bit.\n\nAnd you
    see him...\n\nA boy. A pale, small, thin, and\u2026 very still boy, facing you.
    His crystalline eyes hold yours, not blinking for a moment. You can't take your
    eyes off his. He doesn't move, just stands there. After a few seconds, he smiles.\n\nYour
    body locks.\n\n<color=#E5200F>\u201CIchor.\u201D</color> A voice behind him calls.
    <color=#E5200F>\u201CApproach.\u201D</color> You watch him turn his body first,
    then his head, and walk away toward the voice obediently, taking his gaze off
    you.\n\nYou can't stay here anymore."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: catacombs_ichor2_choices_1
--- !u!114 &-8681532998696386466
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Lektryon_FightEnd
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: lektryon_fightend_line
  editorPosition: {x: 2065, y: 3590}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Your blade leaves his body and you push off him. He lies on the ground,
    just beneath you. You tilt your head slightly, looking at him.\n\nFor a moment,
    no one says anything, but after a few seconds, soft laughs arise among the Order's
    ranks. Lektryon hears it, and his jaw tightens. He pushes himself up, grips his
    sword once more, tenses his shoulders, and his eyes lock onto you.<color=#DBD73C>\u201CGODDAMMIT,
    FACEY! You are going to regret this!\u201D</color> he says, standing his ground.
    He knows he has lost.<color=#DBD73C>\u201CYou think that proves anything?\u201D</color>
    he snaps. <color=#DBD73C>\u201CAgain!\u201D</color>You have already turned away
    from him, leaving the training grounds. You don't really have time for his nonsense
    today.\n\n<color=#DBD73C>\u201CFacey. <b class=\"shake\">FACEY!</b> Come back
    here!\u201D</color>"
  importedSegments:
  - text: 'Your blade leaves his body and you push off him. He lies on the ground,
      just beneath you. You tilt your head slightly, looking at him.


      For
      a moment, no one says anything, but after a few seconds, soft laughs arise
