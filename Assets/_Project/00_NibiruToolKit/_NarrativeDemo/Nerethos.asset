  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: continue_line
  editorPosition: {x: 2615, y: 1775}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Your body jolts forward, and you immediately bring your hands to your throat,
    gasping for air. Cold sweat drips. Your heart pounds fast.\n\nYou touch your
    body, your face, you feel your fingers. Everything is how it\u2019s supposed
    to be, but that feeling lingers...\n\n\u201CWhat the\u2013\u201D you exclaim,
    pushing your entire conscience back into reality.\n\nYou are awake now."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
