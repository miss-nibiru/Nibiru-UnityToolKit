--- !u!114 &7723633378078724936
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Serena_Main
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: serena_main_line
  editorPosition: {x: 2615, y: 7385}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "For a heartbeat, neither of you moves or speaks. The closeness between you
    feels like standing too close to a fire. You should let her go and step back,
    yet...\n\n<color=#FF675E>\u201CYou wear that well,\u201D</color> she says, quieter
    now, inhaling slowly as she composes herself, her eyes never leaving you.\n\n<color=#FF675E>\u201CI
    am the Queen of Nerethos,\u201D</color> she says. <color=#FF675E>\u201CI have
    been for five years now. I speak for this island, for its people... and I serve
    what must be served and endure what must be endured.\u201D</color> Her shoulders
    lower, just slightly. Her hand tenses into a fist, then loosens.<color=#a674e8><i>\u201CHuh...\u201D</i></color>
    Eris whispers, almost pleased. <color=#a674e8><i>\u201CDid you see that?\u201D</i></color>From
    the edge of your vision, Eris leans against the wall, watching the two of you
    with open amusement. <color=#a674e8>\u201CCareful, babe...\u201D</color> She
    hums, tilting her head. <color=#a674e8>\u201CYou don't wanna get too close...\u201D</color>Serena
    shakes her head, as if waking from her own thoughts.\n\nHer eyes return to yours.
    The corner of her lips raises into something like a smile. <color=#FF675E>\u201CThe
    Gods do not bargain... and the rest of us learn to survive what follows... There
    is no other way, and there are worse outcomes than this.\u201D</color>"
  importedSegments:
  - text: "For a heartbeat, neither of you moves or speaks. The closeness between
      you feels like standing too close to a fire. You should let her go and step
      back, yet...\n\n<color=#FF675E>\u201CYou wear that well,\u201D</color> she
      says, quieter now, inhaling slowly as she composes herself, her eyes never
      leaving you.\n\n<color=#FF675E>\u201CI am the Queen of Nerethos,\u201D</color>
      she says. <color=#FF675E>\u201CI have been for five years now. I speak for
      this island, for its people... and I serve what must be served and endure what
      must be endured.\u201D</color> Her shoulders lower, just slightly. Her hand
      tenses into a fist, then loosens."
    condition:
      tokens: []
  - text: "<color=#a674e8><i>\u201CHuh...\u201D</i></color> Eris whispers, almost
      pleased. <color=#a674e8><i>\u201CDid you see that?\u201D</i></color>"
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
          variable: {fileID: 11400000, guid: e2b5c5b2a4f8c4d219da0eec43e8017c, type: 2}
