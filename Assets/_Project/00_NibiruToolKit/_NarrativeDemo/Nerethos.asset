--- !u!114 &-3023634479117949035
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: CastleHall
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: castlehall_line
  editorPosition: {x: 2615, y: 5680}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "<color=#a674e8>\u201COh, come on\u2026\u201D</color> The voice slips in,
    amused. <color=#a674e8>\u201CYou saw it.\u201D</color> A soft laugh follows.
    <color=#a674e8>\u201CYou just don\u2019t want to say it.\u201D</color><color=#a674e8>\u201CYou
    felt it.\u201D</color> She's just beside you now. <color=#a674e8>\u201CWhen that
    thing looked at you...\u201D</color>You press your jaw slightly but continue
    walking down the castle halls in silence. The image of that creature does not
    leave you\u2014that stillness, those eyes fixed too long, too aware, not wild,
    not afraid, but knowing. Something lingers with you. A pressure settles on your
    chest, slow and deliberate, your fingers curling slightly at your side. The motion
    is small, almost imperceptible, but you catch it. You always catch it. A loss
    of control, however slight, does not go unnoticed. And yet, for a moment, it
    hadn\u2019t felt like yours. You bring a hand briefly to your temples, pressing
    against the lingering pain, steadying yourself as you keep moving. You are almost
    out of here.\n\nA soft light moves toward you. You stop immediately.\n\nJust
    ahead, a feminine figure stands at the end of the hall, her face illuminated
    only by the small candle she carries. Dark hair falls in long waves down her
    back. Her skin is warm-toned, her features soft. She wears a long white dress
    and, over it, a deep red cape.\n\nYou recognize her instantly."
  importedSegments:
  - text: "<color=#a674e8>\u201COh, come on\u2026\u201D</color> The voice slips in,
      amused. <color=#a674e8>\u201CYou saw it.\u201D</color> A soft laugh follows.
      <color=#a674e8>\u201CYou just don\u2019t want to say it.\u201D</color>"
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
          variable: {fileID: 11400000, guid: e2b5c5b2a4f8c4d219da0eec43e8017c, type: 2}
          comparison: 0
          booleanValue: 0
          integerValue: 2
          floatValue: 2
          stringValue: 2
          invert: 0
  - text: "<color=#a674e8>\u201CYou felt it.\u201D</color> She's just beside you
      now. <color=#a674e8>\u201CWhen that thing looked at you...\u201D</color>"
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
          variable: {fileID: 11400000, guid: e2b5c5b2a4f8c4d219da0eec43e8017c, type: 2}
          comparison: 3
          booleanValue: 0
          integerValue: 3
          floatValue: 3
          stringValue: 3
          invert: 0
  - text: "You press your jaw slightly but continue walking down the castle halls
      in silence. The image of that creature does not leave you\u2014that stillness,
      those eyes fixed too long, too aware, not wild, not afraid, but knowing. Something
      lingers with you. A pressure settles on your chest, slow and deliberate, your
      fingers curling slightly at your side. The motion is small, almost imperceptible,
      but you catch it. You always catch it. A loss of control, however slight, does
      not go unnoticed. And yet, for a moment, it hadn\u2019t felt like yours. You
      bring a hand briefly to your temples, pressing against the lingering pain,
      steadying yourself as you keep moving. You are almost out of here.\n\nA soft
      light moves toward you. You stop immediately.\n\nJust ahead, a feminine figure
      stands at the end of the hall, her face illuminated only by the small candle
      she carries. Dark hair falls in long waves down her back. Her skin is warm-toned,
      her features soft. She wears a long white dress and, over it, a deep red cape.\n\nYou
      recognize her instantly."
    condition:
