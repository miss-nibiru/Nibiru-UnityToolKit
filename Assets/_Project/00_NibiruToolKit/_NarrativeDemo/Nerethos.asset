  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Catacombs_Entry
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: catacombs_entry_line
  editorPosition: {x: 3495, y: 5185}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: 'You move quickly through the opening, pressing yourself against the doors.
    One of them gives slightly, just enough for you to pass through. You then close
    it behind you.


    Darkness.


    A narrow stairwell leads downward toward
    the subterranean area. You begin your descent, keeping your weight light to avoid
    making any noise, your hand brushing the wall to guide yourself.


    You reach
    the bottom, and the space opens into a wide room. You look around. Walls covered
    in bone. Skulls embedded into the stone, watching from every angle. Black candles
    burn around the edges.


    And... small figures. A dozen? Maybe more. Some
    lying still on the beds. Some restrained to them. Some moving slowly through
    the space, like learning to walk.'
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: catacombs_entry_choices_1
--- !u!114 &-5220698373208806071
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Castle_Prep
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: castle_prep_line
  editorPosition: {x: 2615, y: 2765}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Your blade's steel sings softly as you slide it against the whetstone. Then
    again. The edge catches the light as you wipe it clean and slide it back into
    its sheath at your hip. The second follows on the opposite side.\n\nYou reach
    for your cloak, pulling it over your shoulders as it settles into place.\n\nA
    recon mission inside the Erythros family castle. For centuries, they have been
    a shadow over Nerethos. Tonight, you see for yourself who they really are.\n\nArchon
    ValerianThe highest-ranking individual in the Emerald Order. He controls the
    direction and operations, and holds final authority over all decisions. All ranks
    answer directly to him.\nexpects perfection.\n\nYour jaw tightens slightly as
    you put your mask on. You\u2019ve worn it so long it no longer feels separate
    from you. It completes what the Emerald Order needs you to be. What you are expected
    to be.<color=#a674e8>\u201CGood job, little dog. You are ready.\u201D</color>
    she purrs again in your ear, followed by a sharp, delighted laugh. She's not
    wrong, though...You release a slow breath. You are ready.\n\nA knock cuts through
    the silence."
  importedSegments:
  - text: "Your blade's steel sings softly as you slide it against the whetstone.
      Then again. The edge catches the light as you wipe it clean and slide it back
      into its sheath at your hip. The second follows on the opposite side.\n\nYou
      reach for your cloak, pulling it over your shoulders as it settles into place.\n\nA
      recon mission inside the Erythros family castle. For centuries, they have been
      a shadow over Nerethos. Tonight, you see for yourself who they really are.\n\nArchon
      ValerianThe highest-ranking individual in the Emerald Order. He controls the
      direction and operations, and holds final authority over all decisions. All
      ranks answer directly to him.\nexpects perfection.\n\nYour jaw tightens slightly
      as you put your mask on. You\u2019ve worn it so long it no longer feels separate
      from you. It completes what the Emerald Order needs you to be. What you are
      expected to be."
    condition:
      tokens: []
  - text: "<color=#a674e8>\u201CGood job, little dog. You are ready.\u201D</color>
      she purrs again in your ear, followed by a sharp, delighted laugh. She's not
      wrong, though..."
    condition:
