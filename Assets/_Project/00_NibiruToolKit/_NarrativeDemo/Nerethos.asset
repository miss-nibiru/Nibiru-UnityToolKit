--- !u!114 &-5782480492617251738
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Lektryon_Alchemy_Aggressive
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: lektryon_alchemy_aggressive_line
  editorPosition: {x: 1680, y: 3150}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "He tries to stand up, but you don\u2019t let him. Without a thought or even
    a beat, your blade crashes into his guard, breaking through by sheer force. Then
    again. Then again.\n\nThere\u2019s no rhythm to it anymore, just instinct. Every
    strike forces his arms up to find a defense against you. You can hear it in his
    breathing now. <i>\u201CHe can't keep up. Disgrace.\u201D</i>\n\nYour smile stretches,
    hungry. There is a rhythm to each of your strikes, each landing closer than the
    last; craving more.\n\nYour blades keep coming down at Lektryon. As he tries
    to block again, you break through it. An opening. Your second blade follows toward
    the target, and this time, it hits.\n\nHe hisses and groans through his teeth.
    You keep your blade buried deep into his shoulder and lean forward..."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: lektryon_alchemy_aggressive_choices_1
