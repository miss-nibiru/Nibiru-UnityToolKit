--- !u!114 &5444176575561164705
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: WakeUp
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: wakeup_line
  editorPosition: {x: 2395, y: 1445}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Your body reacts immediately, and you start running toward them.\n\nAs your
    steps hit the floor, you feel it twisting under you. The fog thickens with every
    step. It is going to swallow you.\n\n\u201CFaster. Go faster.\u201D\n\nYou don't
    even get close when the darkness reaches you. It snakes up your legs, pulling
    you down to the ground before you can reach them.\n\nYou look down, and you see
    a shadow stretching across the ground from your feet. You feel your body getting
    bigger, stronger. You bring your hands to your throat, gasping for air, to no
    avail.\n\nThe shadow grows wider. It doesn\u2019t stop."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: wakeup_choices_1
