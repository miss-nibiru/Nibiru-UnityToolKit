--- !u!114 &-327470055585243474
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Catacombs_Ichor1
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: catacombs_ichor1_line
  editorPosition: {x: 3495, y: 5460}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "At the center of the room, a tall, slender figure stands among them. You
    feel his presence overtake the entire room. His posture is straight; dark garments
    fall along his frame, a high collar, and long, straight silver hair. His attention
    rests on one of the smaller forms while the others move around him slowly.\n\n<color=#E5200F>\u201CControl
    it,\u201D</color> the figure says, voice low and steady. <color=#E5200F>\u201CDo
    not suppress it.\u201D</color>\n\nA high-pitched voice answers. \u201C\u2026will
    it hurt again?\u201D A pause.\n\n<color=#E5200F>\u201CYes... But you will learn
    to carry it.\u201D</color> The tone is gentle and patient. The small subject
    nods as the tall figure places their body in front of the smaller individual."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: catacombs_ichor1_choices_1
