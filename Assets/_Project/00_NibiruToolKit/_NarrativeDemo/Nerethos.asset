--- !u!114 &-450494127254170549
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: WarRoom
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: warroom_line
  editorPosition: {x: 3275, y: 3755}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You move through the adjacent corridor until you reach a larger set of doors.
    You quickly move inside and close them behind you.\n\nThe room is wide. It has
    a long table at its center, surrounded by high chairs. Multiple maps cover the
    walls, marked with ink and charcoal. This looks like a room where political decisions
    are made.\n\n<i>\u201CI should be able to find information about the war here...\u201D</i>
    You step toward the largest map, and your eyes narrow slightly. <i>\u201CHold
    on...\u201D</i> You see trade routes. Ports. Locations crossed out, one after
    another.\n\nIs this Nerethos? And not just that... you recognize these. These
    are all black market locations. <i>\u201CThey know where we are?\u201D</i>"
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: warroom_choices_1
