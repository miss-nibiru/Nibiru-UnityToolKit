--- !u!114 &8914556551008831509
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Strawberry_Press
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: strawberry_press_line
  editorPosition: {x: 1240, y: 1390}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Is she serious? Is she just here because the beast is here? You try again.
    You need these answers.\n\n\u201CYou don't have to be here, girl. We just want
    the beast. Why are you still here?\u201D\n\nStrawberry finally looks at you properly.
    <color=#5E9FBC>\u201CI don't want to leave her here all by herself. She would
    feel so alone... What if she gets hurt?\u201D</color> Strawberry starts sobbing
    softly. <color=#5E9FBC>\u201CThis place is cold and wet too, and she hasn't eaten
    her flowers in a few days. I can't leave her... she's my friend...\u201D</color>\n\nFriend?
    A wild beast, and she calls it a friend? Strange. \u201CYou... would rather stay
    locked in to be with your <i>friend</i>?\u201D\n\n<color=#5E9FBC>\u201CYes,\u201D</color>
    she says, wiping her tears off and looking at you with a stern look."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: strawberry_press_choices_1
--- !u!114 &8946614286307850500
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: PrisonSeparated_Strike
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: prisonseparated_strike_line
  editorPosition: {x: 1570, y: 2160}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You reach into the cell, pulling Strawberry toward you.\n\n\u201CFrustrating
    piece of\u2014\u201D Your fist moves before the thought finishes forming. The
    sound cracks through the previously silent prison wing, followed by a thud.\n\nYou
    step away and turn your back. You hear the faint scrape of Strawberry standing
    up. What is she waiting for? Something, anything...\n\nWhen she lifts her head
    again, there's nothing. Your fingers curl into a fist again.\n\n\u201CUseless.\u201D
    You turn away. This was a waste of time."
  importedSegments: []
  useImportedSegments: 0
