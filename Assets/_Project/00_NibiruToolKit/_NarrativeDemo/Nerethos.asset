--- !u!114 &-5651997883540263395
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Damon_Talk
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: damon_talk_line
  editorPosition: {x: 3715, y: 8540}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "<color=#f4a6b8>\u201CMy Lord?\u201D</color> Serena breaks the silence.\n\n<color=#E5200F>\u201C\u2026You
    have not, you say?\u201D</color> the voice finally responds.\n\nYou hear the
    door creak open further, tightening what little space you have to move. You can
    see how Serena loses her composed posture and takes a slight step back.\n\n<color=#E5200F>\u201CSerena,
    my dear\u2026 <b class=\"shake\">you would not be lying to me</b>, correct?\u201D</color>
    he says, now more stern and demanding. <color=#E5200F>\u201CNow, you don't want
    me to bring your little brother, do you?\u201D</color>\n\nShe swallows, looks
    at you again and then back at the voice. <color=#f4a6b8>\u201C\u2026There has
    been no disturbance that I have witnessed, my Lord.\u201D</color>"
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: damon_talk_choices_1
