  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Serena_Vio2
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: serena_vio2_line
  editorPosition: {x: 3550, y: 7000}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Your grip tightens even more now and Serena yelps louder now. She inhales
    sharply, completely cracking.\n\n\u201CEnough!,\u201D she yells. \u201CYou think
    you're strong and mighty?\u201D she snaps, her voice rising. \u201CYou think
    hurting me changes anything?\u201D\n\nFor the first time, she tries to pull free
    and fails. Tries again, pulling harder to no avail.\n\n\u201CGuards! INTRUDER!\u201D<color=#a674e8><i>\"Uh,
    gotta go, dummy\"</i></color>Eris laughs under her breath. <color=#a674e8><i>\"Shouldn't
    play that way with your toys\"</i></color>Eris grins wide, delighted, stepping
    closer behind Serena.<color=#a674e8>\"Oh, you pushed her too far...Run.\"</color>You
    look back as you hear footsteps closing into Serena's chambers. You turn back
    and look at her again. Serena hasn't look away from you.\n\n\u201CYou should
    have left...\u201D she says. \u201CNow you don\u2019t get to.\u201D"
  importedSegments:
  - text: "Your grip tightens even more now and Serena yelps louder now. She inhales
      sharply, completely cracking.\n\n\u201CEnough!,\u201D she yells. \u201CYou
      think you're strong and mighty?\u201D she snaps, her voice rising. \u201CYou
      think hurting me changes anything?\u201D\n\nFor the first time, she tries to
      pull free and fails. Tries again, pulling harder to no avail.\n\n\u201CGuards!
      INTRUDER!\u201D"
    condition:
      tokens: []
  - text: <color=#a674e8><i>"Uh, gotta go, dummy"</i></color>Eris laughs under her
      breath. <color=#a674e8><i>"Shouldn't play that way with your toys"</i></color>
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
          variable: {fileID: 11400000, guid: e2b5c5b2a4f8c4d219da0eec43e8017c, type: 2}
          comparison: 3
