  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: ArchivesA
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: archivesa_line
  editorPosition: {x: 1735, y: 4965}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You take the left corridor and walk down for a little while until you finally
    reach a door that is slightly open at the end of the hall. You push it open and
    slip inside.\n\n\u201CWhat is all this...\u201D Too damn much. Where do you start?\n\nAn
    overwhelming amount of scrolls, rolled maps, books, and bound records fills the
    room. Everything is arranged and stacked perfectly. Your eyes move fast, just
    choosing the first thing you see and opening it.\n\nDates. Names. One specifically
    repeated over and over again. A name people don\u2019t speak anymore. You drop
    it. Next one.\n\nMaps with lines and markings. Is this Nerethos? Unclear. Next.<color=#a674e8>\u201CYou
    can\u2019t even hold onto it, can you? Toooo buzzed?\u201D</color> She laughs.\n\n<i>Shut
    up, shut up...</i>"
  importedSegments:
  - text: "You take the left corridor and walk down for a little while until you
      finally reach a door that is slightly open at the end of the hall. You push
      it open and slip inside.\n\n\u201CWhat is all this...\u201D Too damn much.
      Where do you start?\n\nAn overwhelming amount of scrolls, rolled maps, books,
      and bound records fills the room. Everything is arranged and stacked perfectly.
      Your eyes move fast, just choosing the first thing you see and opening it.\n\nDates.
      Names. One specifically repeated over and over again. A name people don\u2019t
      speak anymore. You drop it. Next one.\n\nMaps with lines and markings. Is this
      Nerethos? Unclear. Next."
    condition:
      tokens: []
  - text: "<color=#a674e8>\u201CYou can\u2019t even hold onto it, can you? Toooo
      buzzed?\u201D</color> She laughs.\n\n<i>Shut up, shut up...</i>"
    condition:
