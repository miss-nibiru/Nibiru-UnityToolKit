  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Lektryon_Pass2
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: lektryon_pass2_line
  editorPosition: {x: 1790, y: 2545}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Lektryon tosses a training sword at your feet. You glance at it and then
    back at him, already settling into stance, steel sword in hand. Then he stops
    for a second to take an item off his belt.\n\nHe lifts the shimmering vial toward
    you.\n\n<color=#DBD73C>\u201CYou want one?\u201D</color> he says, clearly amused.
    <color=#DBD73C>\u201CMight make it more fun...\u201D</color>\n\nHas he always
    been this casual with it? You've beaten him without it before, but he seems...
    changed since."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: lektryon_pass2_choices_1
--- !u!114 &-1901004596208266735
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Lektryon_Strike
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: lektryon_strike_line
  editorPosition: {x: 1350, y: 3260}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Enough. You don\u2019t wait for the next opening; you meet him head-on.
    Your first blade catches his mid-swing, and before he can recover, you\u2019re
    already moving closer.\n\nYour second strike comes immediately. Your weight drives
    both of your bodies forward, unbalancing him and pushing you both to the ground.\n\nBefore
    he can lock eyes with you again, your blade is already at his throat.\n\nLektryon
    freezes for a moment and exhales a loud gasp. His grip tightens around his weapon,
    but he doesn\u2019t move."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: lektryon_strike_choices_1
