--- !u!114 &4969260829261825840
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Serena_Alch
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: serena_alch_line
  editorPosition: {x: 3330, y: 6120}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You push Serena away. Hard; fast. <i>Very</i> hard. The sound of impact
    echoes, and a very high-pitched cry floods your hearing. Your head snaps to the
    side. Pain crawls down your spine.\n\n<i>\u201CWhat did she just say...?\u201D</i>\n\nYou
    try to focus on her again. You can\u2019t. The room folds in on itself. The pipes
    twist. The light flickers. The desk\u2014 the bed\u2014 the walls\u2014 <color=#a674e8>\"\xC3\xC4\u0171\u0172\u0173\u0174\u0175\"</color>Eris
    hums, standing right next to you. Directly in your ear. <color=#a674e8>\"Yo\u0338\u014D\u0337\u014E\u0334\u014F\u0337\u2026
    \u0150\u0338 pu\u0336s\u0337\u0135\u0334\u0136\u0337\u0137\u0334\u2026 k\u0335\u0138\u0336\u0139\u0337\u013A\u0334\u013B\u0336\u013C\u0334d\u2026
    a li\u0336t\u0337t\u0334l\u0337e\u0336 too fa\u0338r\u0337\u2026 di\u0334d\u0336n\u2019\u0337t\u0336
    yo\u0337u\u0334?\"</color>Is Serena still here? Is she looking at you? <i>\u201CWait...
    what did she say?\u201D</i>\n<color=#a674e8>\"\u0145\u0146\xC3\xC4\u014E\u014F\u0167\u0164\u0165\xBE\xBF\u0129\u0128\u012B\u0144\u0143\xD7\u2026
    \u0137\u0129\u0142\u1D52\u1D52\u0137\u0337\u0313\u0341\u033E\u033E\u0315\u0311\u034C\u0341\u0312\u031B\u0313\u035D\u012C\u012D\u012E\u011A\xED\xEE\xEF\xF0\xF1\u0143\u2026\"</color>Eris
    hums, standing right next to you. Directly in your ear. <color=#a674e8>\"\u015B\u1D57\u1D52\u1D52\u2026
    \u1DA0\u1D43\u02B3\u2026\u0119\u0112\u0113\u2026 \u015B\u015A\xC3\u0334\u035D\xC4\u0336\u0340\u0171\u0337\u0344\u2026\u0172\u0334\u034C\u0173\u0336\u2026\u0175\u0337\u0111\u2026
    \u0146\u0143\u0144\xF8\u014Edi\u0334d\u0336n\u2019\u0337t\u0336 yo\u0337u\u0334?\u0143\u011F\u011C\u011D\u2026\"</color>
    She says, licking and nibbling your earlobe.\n\n<color=#a674e8>\"\u0139\u0160\u0161\u0162\u0163\u0160\u0161\u0164\u0165\u0166\u0165\u2019\u015F\u015A\u2026
    \u011E\u011F\xF8\u1D58\u0188\u1D4F\u0337\u0313\u0341\u033E\u033E\u0315\u0311\u034C\u0341\u0312\u031B\u0313\u035D\u2026
    \u0253\u015B\u1D49\u1D49\u0337\u0313\u0341\u033E\u033E\u0315\u0311\u034C\u0341\u0312\u031B\u0313\u035D\u0253\u0253\u2026\"</color>"
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: serena_alch_choices_1
