--- !u!114 &6411046592146613346
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Damon_Talk2
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: damon_talk2_line
  editorPosition: {x: 4100, y: 8265}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Silence again. Serena stands her ground, looking up at the voice. He scoffs,
    then continues back to his calm demeanor. <color=#E5200F>\u201CThe <b>Emerald
    Order</b> has been active,\u201D</color> he says. <color=#E5200F>\u201CMore than
    usual. But they will soon regret it.\u201D</color>\n\nYour chest tightens.\n\n<color=#E5200F>\u201CI
    would advise caution, my Queen,\u201D</color> he continues. You hear him taking
    a step into the room. <color=#E5200F>\u201CThey are mobilizing\u2026 and I would
    rather not believe you would betray your family...\u201D</color>\n\nSerena says
    nothing. He takes another step into the room..."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: damon_talk2_choices_1
--- !u!114 &6453638141337323807
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: WarRoom2
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: warroom2_line
  editorPosition: {x: 1460, y: 5295}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Keep moving, keep moving. You open a ledger with information that looks
    like clinical analysis. \u201CSmall subjects... adaptability... integration...\u201D
    No sense in these words. Next.\n\nYou pull another scroll open on the table,
    extending your arms wide enough to knock a large stack beside you. Papers spill,
    rolls and books hitting the floor with a dull, heavy sound. Too loud. You freeze,
    focusing your hearing for a moment.\n\nFootsteps coming towards you..."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
