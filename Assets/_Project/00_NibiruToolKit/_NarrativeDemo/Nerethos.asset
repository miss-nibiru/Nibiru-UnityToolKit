  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Castle_NoA
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: castle_noa_line
  editorPosition: {x: 2945, y: 3865}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "A few hours have passed, and finally, the castle rises from the mist. Stone
    towers stretch upward, catching the glow of the moon.\n\nYou crouch at the top
    of the outer gates\u2019 tower. From here, you can see the gardens below. Guards.\n\nYour
    eyes track them, timing your movements and learning their patterns. Easy.<color=#a674e8>\u201CStill
    playing \u2018the slow and steady\u2019?\u201D</color> A whisper slips in, always,
    always amused. <color=#a674e8>\u201CYou could be faster.\u201D</color> You ignore
    it.Your body drops silently into the gardens, landing without a sound. You move
    fast along the path traced in your mind, hiding behind bushes and statues, keeping
    steady and quiet. Ahead, the castle walls come into view. Closer now. You see
    a balcony to the west and multiple windows to the east."
  importedSegments:
  - text: "A few hours have passed, and finally, the castle rises from the mist.
      Stone towers stretch upward, catching the glow of the moon.\n\nYou crouch at
      the top of the outer gates\u2019 tower. From here, you can see the gardens
      below. Guards.\n\nYour eyes track them, timing your movements and learning
      their patterns. Easy."
    condition:
      tokens: []
  - text: "<color=#a674e8>\u201CStill playing \u2018the slow and steady\u2019?\u201D</color>
      A whisper slips in, always, always amused. <color=#a674e8>\u201CYou could be
      faster.\u201D</color> You ignore it."
    condition:
