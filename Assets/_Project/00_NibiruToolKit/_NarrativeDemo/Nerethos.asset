--- !u!114 &-2660270159987497436
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Serena_Curious
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: serena_curious_line
  editorPosition: {x: 3550, y: 8100}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Serena leans in, and you get hit by the scent of jasmine. The distance between
    you tightens even more. Her eyes don\u2019t leave your mask. <i>\u201CWhy is
    she...\u201D</i>\n\n<color=#FF675E>\u201C\u2026What are you hiding under that
    mask?\u201D</color> she whispers, and her voice is like silk against your skin.<color=#a674e8><i>\u201CYes...\u201D</i></color>
    Eris hums, amused. <color=#a674e8><i>\u201CWhat are you hiding, babe?\u201D</i></color>Eris
    steps closer, circling Serena, her grin widening. <color=#a674e8>\u201CDon\u2019t
    pull away now\u2026 You want to see what happens, don't you?\u201D</color>For
    a moment, she just watches you. Her composure slips for just a moment. You see
    the slight tension of her jaw, the way her breathing is not quite as steady and
    calm as before. She's close enough that you could reach out and touch the curve
    of her collarbone.\n\nYou don't. But the fact that you're thinking about it means
    you're losing ground. <i>\u201CWake the fuck up!\u201D</i>\n\n<color=#FF675E>\u201CWhy
    are you here, really?\u201D</color> she whispers again, breaking the silence.
    You force yourself to breathe, coming back to your senses, tightening the grip
    on her wrist. She winces softly."
  importedSegments:
  - text: "Serena leans in, and you get hit by the scent of jasmine. The distance
      between you tightens even more. Her eyes don\u2019t leave your mask. <i>\u201CWhy
      is she...\u201D</i>\n\n<color=#FF675E>\u201C\u2026What are you hiding under
      that mask?\u201D</color> she whispers, and her voice is like silk against your
      skin."
    condition:
      tokens: []
  - text: "<color=#a674e8><i>\u201CYes...\u201D</i></color> Eris hums, amused. <color=#a674e8><i>\u201CWhat
      are you hiding, babe?\u201D</i></color>"
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
          variable: {fileID: 11400000, guid: e2b5c5b2a4f8c4d219da0eec43e8017c, type: 2}
          comparison: 0
          booleanValue: 0
          integerValue: 2
          floatValue: 2
          stringValue: 2
          invert: 0
  - text: "Eris steps closer, circling Serena, her grin widening. <color=#a674e8>\u201CDon\u2019t
      pull away now\u2026 You want to see what happens, don't you?\u201D</color>"
