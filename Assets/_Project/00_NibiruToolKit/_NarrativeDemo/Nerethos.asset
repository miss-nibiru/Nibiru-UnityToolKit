--- !u!114 &2142487781823957776
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: NotSeparated
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: notseparated_line
  editorPosition: {x: 1680, y: 1390}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You stop in front of the cell, and you see them. Strawberry is sitting close
    to Blueberry A blue creature, with the head and front legs of a stallion and
    the wings, tail, and hind legs of a rooster.\n, one hand buried in the creature\u2019s
    wings. Blueberry lifts her head when you show up, watching you.\n\nYou break
    the silence after a few minutes of observing their lack of movement. \u201CWhy
    haven\u2019t you tried to escape?\u201D\n\nStrawberry blinks, doubt showing on
    her face. Silence.\n\n\u201CYou have that beast in there with you, and it is
    strong enough to tear through half this wing if it wanted to.\u201D A pause.
    \u201CWhy are you still here?\u201D\n\nStrawberry keeps petting Blueberry and
    smiles at you, as if the question answers itself. <color=#5E9FBC>\u201CShe\u2019s
    not a beast. She\u2019s my friend... and I\u2019m here with her.\u201D</color>\n\n\u201CThat
    is not an answer.\u201D\n\n<color=#5E9FBC>\u201CBut... it is...\u201D</color>"
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: notseparated_choices_1
