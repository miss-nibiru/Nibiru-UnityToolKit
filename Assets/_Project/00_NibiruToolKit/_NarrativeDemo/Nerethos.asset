          booleanValue: 0
          integerValue: 2
          floatValue: 2
          stringValue: 2
          invert: 0
  - text: You feel your jaw tighten a little. The creatures you've seen and capture
      were erratic, capable of tearing trained men in half in a hearbeat.
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
