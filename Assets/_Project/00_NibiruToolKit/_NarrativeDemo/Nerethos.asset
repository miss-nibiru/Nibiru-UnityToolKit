  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Castle_Hub
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: castle_hub_line
  editorPosition: {x: 3165, y: 4360}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You grip the ledge of the window and pull yourself up, entering through
    the open window silently. The hallway stretches ahead. You move through it as
    quietly as you can.\n\nAs you enter the castle, you see very old, tall marble
    vases lining the walls. Some are dark stone, you\u2019re not sure. Over them,
    golden-framed portraits. People dressed formally, too composed and <i>pristine.</i>
    You keep walking down the hallway, looking at all of them quickly until you reach
    one of a woman with sharp features and dark eyes. You stop and tilt your head
    slightly.\n\n<i>\u201CQueen Serena...\u201D</i>\n\nStop. You hear something.
    Voices coming your way. You freeze and slip into the shadows between two pillars
    just as the guards pass your position.\n\n\u201C\u2026but he said the raid was
    necessary.\u201D\n\nA second voice answers almost immediately, angry: \u201CNecessary?
    Nothing about that seemed necessary to me.\u201D They keep walking and fade into
    the distance. You leave your hiding spot.<color=#a674e8>\u201CSee? Even they
    don\u2019t believe in it... And you still follow orders. So weak.\u201D</color>
    You press your jaw tight and move.You keep going forward, reaching a hallway
    that branches into multiple paths. You grin. This was not part of the blueprints.\n\nYou
    don\u2019t have time to explore everything. You\u2019ll have to choose carefully...
    only two of these paths can be observed before you leave the castle.You reach
    the branching corridor again. You don\u2019t have time to explore everything."
  importedSegments:
  - text: "You grip the ledge of the window and pull yourself up, entering through
      the open window silently. The hallway stretches ahead. You move through it
      as quietly as you can.\n\nAs you enter the castle, you see very old, tall marble
      vases lining the walls. Some are dark stone, you\u2019re not sure. Over them,
      golden-framed portraits. People dressed formally, too composed and <i>pristine.</i>
      You keep walking down the hallway, looking at all of them quickly until you
      reach one of a woman with sharp features and dark eyes. You stop and tilt your
      head slightly.\n\n<i>\u201CQueen Serena...\u201D</i>\n\nStop. You hear something.
      Voices coming your way. You freeze and slip into the shadows between two pillars
      just as the guards pass your position.\n\n\u201C\u2026but he said the raid
      was necessary.\u201D\n\nA second voice answers almost immediately, angry: \u201CNecessary?
      Nothing about that seemed necessary to me.\u201D They keep walking and fade
      into the distance. You leave your hiding spot."
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 1
          flag: {fileID: 11400000, guid: 2ba5c07f00fca40d09b1b283988c5b28, type: 2}
          variable: {fileID: 0}
          comparison: 0
          booleanValue: 0
          integerValue: 0
          floatValue: 0
          stringValue: 
          invert: 0
