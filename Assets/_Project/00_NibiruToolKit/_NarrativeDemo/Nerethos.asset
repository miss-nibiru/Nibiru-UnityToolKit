--- !u!114 &-8057401578759012230
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Separated
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: separated_line
  editorPosition: {x: 1680, y: 1720}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "You get to the cell. Strawberry sits where she always does, curled inward.\n\n\u201CWhy
    haven\u2019t you tried to escape?\u201D Your tone is commanding and stern, but
    no answer comes from Strawberry.\n\n\u201CThe creature that was with you is a
    wild animal.\u201D You tilt your head slightly. \u201CWhy is it not attacking
    you?\u201D\n\nYou pause, waiting for her to speak. She only looks past you, remaining
    silent.\n\n\u201CThat thing is strong enough to tear through half of this wing
    if it wanted to. Why didn\u2019t you use it?\u201D\n\nNothing. Her eyes seem
    to be looking at you, but they remain unfocused, as if you\u2019re not there
    at all. Your jaw tightens."
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: separated_choices_1
