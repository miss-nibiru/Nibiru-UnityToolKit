--- !u!114 &768352735544088455
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Serena_Room
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: serena_room_line
  editorPosition: {x: 2615, y: 6340}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "The door to Queen Serena\u2019s chambers opens, and you immediately feel
    the difference. The rest of the castle is stone and ancient... but this space
    breathes.\n\nThin brass pipes snake along the circular-shaped room. Candles flicker
    in mechanical holders attached to the pipes, and the air faintly smells of oil
    and smoke. Multiple artifactsNerethos blends classical Greco-Roman architecture
    with steampunk innovation. Everything here is handcrafted, industrial, built
    over ancient foundations.\nline the far wall. Tools arranged with obsessive care.
    A working station.\n\nRight in front of you, a gigantic bed, and beyond that,
    even bigger windows framed with steel. The curtains of all the windows dance
    with the wind from the one that remains open to your left, where papers are scattered
    on a desk. It is a whirlpool of blueprints, schematics, leather-bound notebooks.You
    feel an immediate, sharp pain going from your head down your spine. For a second,
    your vision blurs. Serena\u2019s mouth moves. The room hums. From the corner
    of your eye, you see Eris once more. <color=#a674e8>\u201CFeeling okay there,
    \u2018Legate\u2019?\u201D</color> She says as she salutes you and laughs maniacally.
    <color=#a674e8>\u201CShould\u2019ve slowed down.\u201D</color>Where the rest
    of the castle clings to stone, this room breathes progress, much as all Nerethos
    should... except for the Erythros castle. <i>\u201CWhat is this place?\u201D</i>"
  importedSegments:
  - text: "The door to Queen Serena\u2019s chambers opens, and you immediately feel
      the difference. The rest of the castle is stone and ancient... but this space
      breathes.\n\nThin brass pipes snake along the circular-shaped room. Candles
      flicker in mechanical holders attached to the pipes, and the air faintly smells
      of oil and smoke. Multiple artifactsNerethos blends classical Greco-Roman architecture
      with steampunk innovation. Everything here is handcrafted, industrial, built
      over ancient foundations.\nline the far wall. Tools arranged with obsessive
      care. A working station.\n\nRight in front of you, a gigantic bed, and beyond
      that, even bigger windows framed with steel. The curtains of all the windows
      dance with the wind from the one that remains open to your left, where papers
      are scattered on a desk. It is a whirlpool of blueprints, schematics, leather-bound
      notebooks."
    condition:
      tokens: []
  - text: "You feel an immediate, sharp pain going from your head down your spine.
      For a second, your vision blurs. Serena\u2019s mouth moves. The room hums.
      From the corner of your eye, you see Eris once more. <color=#a674e8>\u201CFeeling
      okay there, \u2018Legate\u2019?\u201D</color> She says as she salutes you and
      laughs maniacally. <color=#a674e8>\u201CShould\u2019ve slowed down.\u201D</color>"
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
          variable: {fileID: 11400000, guid: e2b5c5b2a4f8c4d219da0eec43e8017c, type: 2}
          comparison: 3
          booleanValue: 0
          integerValue: 4
          floatValue: 4
          stringValue: 4
          invert: 0
  - text: "Where the rest of the castle clings to stone, this room breathes progress,
      much as all Nerethos should... except for the Erythros castle. <i>\u201CWhat
      is this place?\u201D</i>"
    condition:
      tokens:
      - tokenType: 0
        condition:
          mode: 2
          flag: {fileID: 0}
          variable: {fileID: 11400000, guid: e2b5c5b2a4f8c4d219da0eec43e8017c, type: 2}
          comparison: 3
          booleanValue: 0
          integerValue: 4
          floatValue: 4
          stringValue: 4
          invert: 0
      - tokenType: 3
        condition:
          mode: 0
          flag: {fileID: 0}
          variable: {fileID: 0}
          comparison: 0
          booleanValue: 1
          integerValue: 0
          floatValue: 0
          stringValue: 
          invert: 0
  useImportedSegments: 1
