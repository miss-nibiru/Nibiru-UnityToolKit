--- !u!114 &-7857973399854523332
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a61b9e76000000000000000000000044, type: 3}
  m_Name: Serena_Ante
  m_EditorClassIdentifier: MissNibiru.Narrative::MissNibiru.Narrative.NarrativeLineNode
  id: serena_ante_line
  editorPosition: {x: 2615, y: 6010}
  character: {fileID: 0}
  emotion: {fileID: 0}
  portraitSide: 0
  text: "Queen Serena; the Lady of Nerethos.\n\nYou observe her from the shadows
    as she speaks with a guard across the corridor. \u201CThere\u2019s been movement
    in the castle tonight. You should be careful, my lady. If someone got this far...\u201D\n\n<color=#FF675E>\u201CI
    am aware,\u201D</color> she says, cutting him off.\n\nThe guard hesitates. \u201C\u2026of
    course, my apologies. Excuse me.\u201D He bows and steps back, leaving Serena
    alone. The candlelight trembles slightly in her hand.\n\nYou stay still, waiting
    for her to leave\u2014\n\n<color=#FF675E>\u201CYou shouldn\u2019t be here.\u201D</color>\n\nYou
    freeze.\n\nShe doesn\u2019t turn, but begins walking forward. <color=#FF675E>\u201CCome...\u201D</color>"
  importedSegments: []
  useImportedSegments: 0
  wordLimit: 60
  typewriterSpeed: 0
  autoAdvance: 0
  autoAdvanceDelay: 1
  background: {fileID: 0}
  music: {fileID: 0}
  voiceClip: {fileID: 0}
  soundEffect: {fileID: 0}
  nextNodeId: serena_ante_choices_1
